<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Booking | WEDDINGLY</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<div class="page-shell"><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/bookings">WEDDINGLY<span>✿</span></a><nav><a href="${pageContext.request.contextPath}/bookings">Booking Management</a><a class="nav-active" href="${pageContext.request.contextPath}/bookings">Bookings</a></nav></header><main class="form-main"><a class="back-link" href="${pageContext.request.contextPath}/bookings">← Back to bookings</a><section class="form-card"><div class="form-intro"><span class="eyebrow rose">CUSTOMER + VENDOR RESERVATION</span><h1><c:choose><c:when test="${not empty booking.id}">Update booking</c:when><c:otherwise>Create a booking</c:otherwise></c:choose></h1><p>Connect a customer to a vendor service and keep the event details together.</p></div>
<c:if test="${not empty errors}"><div class="notice warning"><strong>Please check these details:</strong><ul><c:forEach items="${errors}" var="error"><li><c:out value="${error}"/></li></c:forEach></ul></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/bookings" class="plan-form"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value='${booking.id}'/>"><div class="form-section-title"><span>01</span><div><h2>People and service</h2><p>Use the IDs from your team's Customer and Vendor modules.</p></div></div><div class="field-grid"><label class="field">Customer ID <span>*</span><input name="customerId" required maxlength="60" placeholder="e.g. CUS-001" value="<c:out value='${booking.customerId}'/>"/></label><label class="field">Customer name <span>*</span><input name="customerName" required maxlength="100" placeholder="Customer name" value="<c:out value='${booking.customerName}'/>"/></label><label class="field">Vendor ID <span>*</span><input name="vendorId" required maxlength="60" placeholder="e.g. VEN-004" value="<c:out value='${booking.vendorId}'/>"/></label><label class="field">Vendor name <span>*</span><input name="vendorName" required maxlength="100" placeholder="Vendor or company name" value="<c:out value='${booking.vendorName}'/>"/></label><label class="field full">Booked service <span>*</span><input name="serviceName" required maxlength="120" placeholder="e.g. Wedding photography package" value="<c:out value='${booking.serviceName}'/>"/></label></div>
<div class="form-section-title second"><span>02</span><div><h2>Booking details</h2><p>Set the date, status and agreed amount.</p></div></div><div class="field-grid"><label class="field">Event date <span>*</span><input type="date" name="eventDate" required min="<%= java.time.LocalDate.now() %>" value="<c:out value='${booking.eventDate}'/>"/></label><label class="field">Booking status <span>*</span><select name="status" required><option value="Pending" <c:if test="${booking.status == 'Pending'}">selected</c:if>>Pending</option><option value="Confirmed" <c:if test="${booking.status == 'Confirmed'}">selected</c:if>>Confirmed</option><option value="Completed" <c:if test="${booking.status == 'Completed'}">selected</c:if>>Completed</option><option value="Cancelled" <c:if test="${booking.status == 'Cancelled'}">selected</c:if>>Cancelled</option></select></label><label class="field">Agreed amount (LKR) <span>*</span><input type="number" name="amount" required min="0" step="0.01" placeholder="50000" value="<c:out value='${booking.amount}'/>"/></label><label class="field full">Notes<textarea name="notes" rows="4" maxlength="1000" placeholder="Add booking notes, requirements or payment details..."><c:out value="${booking.notes}"/></textarea></label></div><div class="form-actions"><a class="button button-quiet" href="${pageContext.request.contextPath}/bookings">Cancel</a><button class="button button-dark" type="submit"><c:choose><c:when test="${not empty booking.id}">Save changes</c:when><c:otherwise>Save booking</c:otherwise></c:choose><span>↗</span></button></div></form></section></main><footer><a class="brand" href="${pageContext.request.contextPath}/bookings">WEDDINGLY<span>✿</span></a><span>Bookings · Customers · Vendors</span></footer></div></body></html>

