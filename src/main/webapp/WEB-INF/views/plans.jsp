<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Wedding Plans | WEDDINGLY</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<div class="page-shell"><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/weddings">WEDDINGLY<span>✿</span></a><nav><a class="nav-active" href="${pageContext.request.contextPath}/weddings">Wedding Plans</a><span class="nav-muted">Plan · Book · Celebrate</span></nav><a class="avatar" href="#content">WP</a></header>
<main id="content"><section class="hero"><div class="hero-copy"><span class="eyebrow">YOUR DAY, BEAUTIFULLY PLANNED</span><h1>Every lovely detail,<br><em>in one place.</em></h1><p>Keep your wedding plans organized, from the first idea to the “I do”.</p><a class="button button-light" href="${pageContext.request.contextPath}/weddings?action=new"><span>＋</span> Create a plan</a></div><div class="hero-note"><span class="sparkle">✦</span><span>Made for your<br>once-in-a-lifetime day</span></div></section>
<section class="content-wrap"><div class="section-heading"><div><span class="eyebrow rose">YOUR CELEBRATION</span><h2>Wedding plans</h2><p class="subtext">A little more organized. A lot more magical.</p></div><form class="search" method="get" action="${pageContext.request.contextPath}/weddings"><span>⌕</span><input name="q" value="<c:out value='${param.q}'/>" placeholder="Search couple, venue or style"><button aria-label="Search">Search</button></form></div>
<c:if test="${param.saved == '1'}"><div class="notice">Your wedding plan has been saved. ✨</div></c:if><c:if test="${param.deleted == '1'}"><div class="notice">Wedding plan removed successfully.</div></c:if><c:if test="${param.missing == '1'}"><div class="notice warning">That plan could not be found. The list has been refreshed.</div></c:if>
<div class="stats"><div class="stat"><span class="stat-icon">♡</span><div><strong><c:out value="${plans.size()}"/></strong><small>Plans in your collection</small></div></div><div class="stat"><span class="stat-icon">✧</span><div><strong>One beautiful day</strong><small>Thoughtfully planned by you</small></div></div><a class="text-link" href="${pageContext.request.contextPath}/weddings?action=new">Start planning <span>↗</span></a></div>
<c:choose><c:when test="${empty plans}"><div class="empty-state"><div class="empty-flower">✿</div><h3>Your story starts here</h3><p>Create your first wedding plan and keep every special detail together.</p><a class="button button-dark" href="${pageContext.request.contextPath}/weddings?action=new">Create your first plan</a></div></c:when><c:otherwise><div class="plan-grid"><c:forEach items="${plans}" var="plan" varStatus="loop"><article class="plan-card"><div class="card-top"><span class="plan-pill"><c:out value="${labels[loop.index]}"/></span><span class="card-flower">✿</span></div><h3><c:out value="${plan.coupleNames}"/></h3><p class="plan-theme"><c:out value="${plan.theme}"/> celebration</p><div class="detail-line"><span>♡</span><span><c:out value="${plan.weddingDate}"/></span></div><div class="detail-line"><span>⌖</span><span><c:out value="${plan.venue}"/></span></div><div class="card-divider"></div><div class="card-foot"><span><b><c:out value="${plan.guestCount}"/></b> guests · <b>LKR <c:out value="${plan.budget}"/></b></span><div class="actions"><a class="edit-link" href="${pageContext.request.contextPath}/weddings?action=edit&amp;id=<c:out value='${plan.id}'/>" aria-label="Edit plan">Edit</a><form method="post" action="${pageContext.request.contextPath}/weddings" onsubmit="return confirm('Delete this wedding plan? This cannot be undone.');"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${plan.id}'/>"><button class="delete-link" type="submit">Delete</button></form></div></div></article></c:forEach></div></c:otherwise></c:choose></section></main>
<footer><a class="brand" href="${pageContext.request.contextPath}/weddings">WEDDINGLY<span>✿</span></a><span>Plan with love. Celebrate every moment.</span></footer></div></body></html>
