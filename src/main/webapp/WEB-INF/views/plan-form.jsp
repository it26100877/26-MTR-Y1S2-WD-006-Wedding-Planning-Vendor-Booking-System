<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:choose><c:when test="${not empty plan.id}">Edit</c:when><c:otherwise>Create</c:otherwise></c:choose> a Wedding Plan | WEDDINGLY</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<div class="page-shell"><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/weddings">WEDDINGLY<span>✿</span></a><nav><a class="nav-active" href="${pageContext.request.contextPath}/weddings">Wedding Plans</a><span class="nav-muted">Plan · Book · Celebrate</span></nav><a class="avatar" href="${pageContext.request.contextPath}/weddings">WP</a></header>
<main class="form-main"><a class="back-link" href="${pageContext.request.contextPath}/weddings">← Back to wedding plans</a><section class="form-card"><div class="form-intro"><span class="eyebrow rose">THE BEGINNING OF SOMETHING LOVELY</span><h1><c:choose><c:when test="${not empty plan.id}">Edit your plan</c:when><c:otherwise>Let's plan your day</c:otherwise></c:choose></h1><p>Save the details you know. You can always update them as your ideas bloom.</p></div>
<c:if test="${not empty errors}"><div class="notice warning"><strong>A few details need your attention:</strong><ul><c:forEach items="${errors}" var="error"><li><c:out value="${error}"/></li></c:forEach></ul></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/weddings" class="plan-form"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value='${plan.id}'/>">
<div class="form-section-title"><span>01</span><div><h2>Your celebration</h2><p>Start with the most important details.</p></div></div><div class="field-grid"><label class="field full">Couple's names <span>*</span><input name="coupleNames" required minlength="3" maxlength="100" placeholder="e.g. Amaya & Kavindu" value="<c:out value='${plan.coupleNames}'/>"/></label><label class="field">Wedding date <span>*</span><input type="date" name="weddingDate" required min="<%= java.time.LocalDate.now() %>" value="<c:out value='${plan.weddingDate}'/>"/></label><label class="field">Venue <span>*</span><input name="venue" required maxlength="120" placeholder="Venue or town" value="<c:out value='${plan.venue}'/>"/></label></div>
<div class="form-section-title second"><span>02</span><div><h2>Your vision</h2><p>Shape the feel of your special day.</p></div></div><div class="field-grid"><label class="field">Wedding style <span>*</span><select name="theme" required><option value="">Choose a style</option><option value="Romantic Garden" <c:if test="${plan.theme == 'Romantic Garden'}">selected</c:if>>Romantic Garden</option><option value="Classic Elegance" <c:if test="${plan.theme == 'Classic Elegance'}">selected</c:if>>Classic Elegance</option><option value="Beach Celebration" <c:if test="${plan.theme == 'Beach Celebration'}">selected</c:if>>Beach Celebration</option><option value="Modern Minimal" <c:if test="${plan.theme == 'Modern Minimal'}">selected</c:if>>Modern Minimal</option><option value="Traditional" <c:if test="${plan.theme == 'Traditional'}">selected</c:if>>Traditional</option><option value="Rustic Charm" <c:if test="${plan.theme == 'Rustic Charm'}">selected</c:if>>Rustic Charm</option></select></label><label class="field">Guest count <span>*</span><input type="number" name="guestCount" required min="1" max="10000" placeholder="150" value="<c:out value='${plan.guestCount}'/>"/></label><label class="field">Estimated budget (LKR) <span>*</span><input type="number" name="budget" required min="0" step="0.01" placeholder="2500000" value="<c:out value='${plan.budget}'/>"/></label><label class="field full">Notes for your day<textarea name="notes" rows="4" maxlength="1000" placeholder="Add a personal note, colour palette, or anything you want to remember..."><c:out value="${plan.notes}"/></textarea></label></div>
<div class="form-actions"><a class="button button-quiet" href="${pageContext.request.contextPath}/weddings">Cancel</a><button class="button button-dark" type="submit"><c:choose><c:when test="${not empty plan.id}">Save changes</c:when><c:otherwise>Save wedding plan</c:otherwise></c:choose><span>↗</span></button></div></form></section></main><footer><a class="brand" href="${pageContext.request.contextPath}/weddings">WEDDINGLY<span>✿</span></a><span>Plan with love. Celebrate every moment.</span></footer></div></body></html>
