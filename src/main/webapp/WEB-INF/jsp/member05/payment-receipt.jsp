<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Receipt <c:out value="${payment.paymentId}"/></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>body{background:#f7f3ed;color:#352f27}.receipt{max-width:680px;margin:45px auto;background:white;padding:42px;border:1px solid #eadfce}.brand{font:700 30px Georgia;color:#8d6a22}.amount{font:700 30px Georgia}@media print{body{background:white}.receipt{margin:0 auto;border:0}}</style></head><body><section class="receipt">
<div class="d-flex justify-content-between"><div><div class="brand">Éclat.</div><div class="text-secondary">Payment receipt</div></div><div class="text-end"><strong>RECEIPT</strong><br><c:out value="${payment.paymentId}"/></div></div><hr>
<h3 class="mt-4">Payment received</h3><p class="text-secondary">This receipt documents a payment record stored in the system. It is not evidence of bank settlement.</p>
<div class="bg-light p-3 my-4"><div class="text-secondary">Recorded amount</div><div class="amount">LKR <c:out value="${payment.amount}"/></div></div>
<table class="table"><tr><th>Contract</th><td><c:out value="${contract.contractId}"/></td></tr><tr><th>Booking</th><td><c:out value="${contract.bookingId}"/></td></tr><tr><th>Customer</th><td><c:out value="${customer.name}"/> (<c:out value="${customer.email}"/>)</td></tr><tr><th>Payment type</th><td><c:out value="${payment.paymentType}"/></td></tr><tr><th>Payment date</th><td><c:out value="${payment.paymentDate}"/></td></tr><tr><th>Recorded at</th><td><c:out value="${payment.recordedAt}"/></td></tr><tr><th>Method</th><td><c:out value="${payment.paymentMethod}"/></td></tr><tr><th>Reference</th><td><c:out value="${payment.transactionRef}"/></td></tr><tr><th>Status</th><td><c:out value="${payment.voided ? 'VOIDED' : 'VALID'}"/></td></tr><tr><th>Notes</th><td><c:out value="${payment.notes}"/></td></tr></table>
<p class="text-secondary small">Please contact the administrator if any details on this receipt are incorrect.</p><div class="text-center mt-4"><button class="btn btn-dark" onclick="window.print()">Print / Save as PDF</button></div></section></body></html>